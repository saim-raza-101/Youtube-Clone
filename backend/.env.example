# ============================================================
# Vidora Backend — copy this file to .env and fill in your values
#   cp .env.example .env
# Never commit your real .env (secrets stay private)
# ============================================================


# ----- Server -----
# Port your Express API listens on (frontend calls this)
PORT=8000

# Where your React app runs — used for CORS (who is allowed to call the API)
CORS_ORIGIN=http://localhost:5173

# Frontend URL for OAuth redirects after Google/GitHub login
# (same as CORS_ORIGIN in local dev)
FRONTEND_URL=http://localhost:5173


# ----- Database (MongoDB) -----
# Connection string from MongoDB Atlas (or local Mongo)
# Replace <username>, <password>, and cluster host with yours
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net


# ----- JWT (your app login tokens) -----
# Long random strings you invent — used to sign tokens so nobody can fake them
# Example: openssl rand -hex 32
JWT_ACCESS_TOKEN_SECRET=your_access_token_secret_here
# How long an access token lasts (1d = 1 day, 15m = 15 minutes)
JWT_ACCESS_TOKEN_EXPIRY=1d

JWT_REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
# How long a refresh token lasts (used to get a new access token)
JWT_REFRESH_TOKEN_EXPIRY=7d


# ----- Cloudinary (video + image uploads) -----
# From https://cloudinary.com dashboard → Account Details
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret


# ----- GitHub OAuth ("Continue with GitHub") -----
# Create at: GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
# Homepage URL:        http://localhost:5173
# Authorization callback URL: must match GITHUB_CALLBACK_URL below
GITHUB_CLIENT_ID=xxxxxxxxxxxxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxx
GITHUB_CALLBACK_URL=http://localhost:8000/api/v1/users/auth/github/callback


# ----- Google OAuth ("Continue with Google") — optional -----
# Needs a Google Cloud project + OAuth client (may ask for billing in some regions)
# Leave empty if you cannot create Google credentials yet
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/api/v1/users/auth/google/callback
