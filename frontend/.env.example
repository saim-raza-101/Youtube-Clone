# ============================================================
# Vidora Frontend — copy this file to .env and fill in your values
#   cp .env.example .env
# Only VITE_ variables are exposed to the browser (never put secrets here)
# ============================================================

# Full base URL of your backend API (must match backend PORT + /api/v1)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Max wait time for API requests, in milliseconds (10000 = 10 seconds)
VITE_API_TIMEOUT=10000
